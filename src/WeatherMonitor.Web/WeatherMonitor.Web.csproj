<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>ASP.NET Core MVC API and host for the React front end.</Description>
    <SpaRoot>..\weather-monitor.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <!-- Not a secret: the name of this project's local user-secrets folder
         (%APPDATA%\Microsoft\UserSecrets\<id>\secrets.json), read in Development only. It lets a developer override
         settings such as the connection string without touching files under source control. -->
    <UserSecretsId>weather-monitor-web-e3a9e6bc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeatherMonitor.Application\WeatherMonitor.Application.csproj" />
    <ProjectReference Include="..\WeatherMonitor.Infrastructure\WeatherMonitor.Infrastructure.csproj" />
    <!-- Builds the React app and copies its output into wwwroot on publish. -->
    <ProjectReference Include="..\weather-monitor.client\weather-monitor.client.esproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WeatherMonitor.Web.Tests" />
  </ItemGroup>

</Project>
